{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "risk values",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "source", "secrets", "datasource"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Never", "IfNotPresent", "Always"] }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "source": { "enum": ["KIS", "KIS_PAPER", "SIMULATOR", "REPLAY"] },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["db"],
      "properties": {
        "db": { "type": "string", "minLength": 1 }
      }
    },
    "datasource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "pattern": "^jdbc:postgresql://" }
      }
    },
    "javaOpts": { "type": "string" },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" }
      }
    }
  }
}
