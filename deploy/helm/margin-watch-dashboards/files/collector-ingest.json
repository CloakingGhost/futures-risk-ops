{
  "uid": "mw-collector-ingest",
  "title": "마진워치 수집 상태",
  "description": "collector 의 웹소켓 상태, 장중 여부, 체결 수신 간격, 수신 속도, 재접속·누락, 일봉 성공 시각. 운영 지표만 보여주며 시세·가격 값은 없다.",
  "tags": [
    "margin-watch"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "WebSocket 상태",
      "description": "collector_ws_state 에서 값이 1 인 상태 이름이다(IDLE, CONNECTING, SUBSCRIBED, BACKOFF). SUBSCRIBED 가 정상이다. 장이 닫힌 시간에는 접속하지 않아 IDLE 일 수 있다(KIS 프로필의 세션 게이트).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (state) (collector_ws_state{job=\"collector\"}) == 1",
          "legendFormat": "{{state}}",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "SUBSCRIBED"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "BACKOFF"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CONNECTING"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "IDLE"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "name",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "장중 여부",
      "description": "collector_market_session_open: 세션 캘린더 기준으로 지금 주간장·야간장 안이면 1. 마감 뒤 10초는 접속이 남아 있어도 0 이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 4,
        "h": 4
