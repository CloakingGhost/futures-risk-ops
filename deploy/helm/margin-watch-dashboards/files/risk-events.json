    {
      "id": 7,
      "type": "timeseries",
      "title": "risk 응답 지연 (평균·최댓값)",
      "description": "평균은 _sum / _count 의 5분 값, 최댓값은 http_server_requests_seconds_max 다. 이 지표는 히스토그램 칸(_bucket)을 내보내지 않아 백분위(p95)는 구하지 못한다.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{job=\"risk\", uri!~\"/actuator.*\"}[5m])) / sum by (uri) (rate(http_server_requests_seconds_count{job=\"risk\", uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "평균 {{uri}}",
          "refId": "A",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "max by (uri) (http_server_requests_seconds_max{job=\"risk\", uri!~\"/actuator.*\"})",
          "legendFormat": "최대 {{uri}}",
          "refId": "B",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
