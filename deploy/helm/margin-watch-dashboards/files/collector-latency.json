{
  "uid": "mw-collector-latency",
  "title": "마진워치 수집 지연",
  "description": "체결→수신, 수신→커밋 지연의 p50·p95·p99. 히스토그램 칸 안을 보간한 추정치다.",
  "tags": [
    "margin-watch"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
