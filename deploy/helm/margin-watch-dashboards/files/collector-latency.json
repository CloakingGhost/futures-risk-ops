    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "체결→수신 지연 p50·p95·p99",
      "description": "체결 시각(bsop_hour)에서 수신까지. 한계: bsop_hour 가 초 단위라 지연이 0~1초 부풀려진다(칸 경계 0.5초 아래는 의미가 없다). 수신은 PC 시계, 체결은 KIS 시계라서 PC 시계가 늦으면 음수가 0 으로 세어져 지연이 실제보다 작게 보인다. 칸 안 보간 추정치다. 체결이 없는 시간(장외)에는 비어 있다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(collector_trade_to_receive_seconds_bucket{job=\"collector\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(collector_trade_to_receive_seconds_bucket{job=\"collector\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(collector_trade_to_receive_seconds_bucket{job=\"collector\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "수신→커밋 지연 p50·p95·p99",
      "description": "수신에서 tick_trade 배치 INSERT 가 끝날 때까지. 체결만 잰다(호가 제외). 배치 대기가 들어 있어서 체결이 뜸할 때 최대 약 0.2초(flush-interval-ms=200)가 더해진다. p95 가 1초를 넘고 5분 이어지면 알람(CollectorIngestLatencyP95High). 칸 안 보간 추정치다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
