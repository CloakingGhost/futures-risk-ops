# 한국투자증권 API
## 실전 (프로필 kis)
KIS_APP_KEY=
KIS_APP_SECRET=
## 모의투자 (프로필 kis-paper)
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=

# 로컬 PostgreSQL (docker compose, collector)
POSTGRES_USER=
POSTGRES_PASSWORD=

# docker compose --profile app 로 앱을 띄울 때만 쓴다(값은 비밀이 아니다)
## collector 프로필: 비우면 kis(실전). kis-paper 는 모의투자, default 는 시뮬레이터(--profile sim 도 붙인다)
COLLECTOR_PROFILE=
## risk 가 읽을 출처: 비우면 KIS. KIS_PAPER, SIMULATOR (collector 프로필과 맞춘다)
RISK_SOURCE=
## 일봉 첫 실호출 확인용(docs/kis-daily-bar.md): 시작 직후 한 번 받기(true), 시장 코드(F 또는 F,CM). 비우면 false, F
DAILY_CLOSE_RUN_ON_START=
DAILY_CLOSE_MARKETS=
## 일봉을 최근 며칠 치 받을지(1~100). 비우면 5. 며칠 꺼 뒀다 켜서 메울 때 늘린다
DAILY_CLOSE_LOOKBACK_DAYS=

# Slack
## Alertmanager 알람을 받는 Slack Incoming Webhook 주소(비밀). deploy/monitoring/create-slack-secret.sh 가 Secret 으로 만든다
SLACK_ALERTS_WEBHOOKS=
SLACK_ALERTS_CHANNEL=
SLACK_APPROVALS_CHANNEL=
SLACK_INCIDENTS_CHANNEL=
SLACK_MEMBER_ID=