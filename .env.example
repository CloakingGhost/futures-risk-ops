# 한국투자증권 API
## 실전 (프로필 kis)
KIS_APP_KEY=
KIS_APP_SECRET=
## 모의투자 (프로필 kis-paper)
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
## 계좌번호(코드는 읽지 않는다. 필요해지면 이름을 확정한다)
KIS_PAPER_ACCOUNT=

# 로컬 PostgreSQL (docker compose, collector)
POSTGRES_USER=
POSTGRES_PASSWORD=

# docker compose --profile app 로 앱을 띄울 때만 쓴다(값은 비밀이 아니다)
## collector 프로필: 비우면 시뮬레이터, kis-paper 는 모의투자, kis 는 실전
COLLECTOR_PROFILE=
## risk 가 읽을 출처: SIMULATOR, KIS_PAPER, KIS (collector 프로필과 맞춘다)
RISK_SOURCE=

# Slack
SLACK_ALERTS_CHANNEL=
SLACK_APPROVALS_CHANNEL=
SLACK_INCIDENTS_CHANNEL=
SLACK_MEMBER_ID=